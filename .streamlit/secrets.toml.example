# Local secrets for running Streamlit on your machine.
# 1. Copy this file to ".streamlit/secrets.toml" (remove the .example).
# 2. Paste your real Gemini key below.
# secrets.toml is gitignored, so your key never gets pushed to GitHub.
#
# On Streamlit Cloud you do NOT use this file — instead paste the same line
# under Settings -> Secrets in the app dashboard.

GEMINI_API_KEY = "paste-your-key-here"
